#!/bin/sh
# dsb-admin: the admin's one tool for dsb. dsb.conf is the only source of
# truth; units are generated from it at boot and on every apply
# (dsb-generator), users are created from it (systemd-sysusers).
#
#   dsb-admin check    validate /etc/dsb/dsb.conf and conf.d/*.conf against
#                       docs/standards.md, and score the units it generates
#   dsb-admin check --show-deny
#                       the deny list no key can reach: built in plus
#                       [global] deny-paths, deny-groups, deny-caps
#   dsb-admin apply    validate, create the identities' users, regenerate
#                       the units, (re)start their sockets, stop removed ones
#   dsb-admin list     enabled identities and their sockets
#
#   dsb-admin --dev [--config FILE] apply | stop | env
#                       the same as your own user units, to test without
#                       root: the sandbox, policy and protocol are real, the
#                       identity is you (a user manager cannot switch users)
set -eu

DSBD="${DSBD:-/usr/libexec/dsb/dsbd}"
CONF=/etc/dsb/dsb.conf
DEV=
HERE="$(cd "$(dirname "$0")" && pwd)"

usage() { sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-1}"; }

while [ $# -gt 0 ]; do
  case "$1" in
    --dev) DEV=1 ;;
    --config) CONF="$(realpath "$2")"; shift ;;
    -h|--help) usage 0 ;;
    *) break ;;
  esac
  shift
done
[ $# -ge 1 ] || usage

if [ -n "$DEV" ]; then
  # a source checkout: use (and build) its dsbd
  if [ -x "$HERE/../build.sh" ]; then "$HERE/../build.sh" >/dev/null; DSBD="$HERE/../out/dsbd"; fi
  RT="${XDG_RUNTIME_DIR:?}"
  D="$RT/dsb-dev"
  RUNDIR="$D"
  UNITS="$RT/systemd/user"
  SC="systemctl --user"
else
  UNITS=/run/systemd/generator
  RUNDIR=/run/dsb
  SC=systemctl
fi

# the most exposure systemd-analyze may score a generated unit (rule 5 in
# docs/standards.md). Measured on systemd 261: 1.1 with every default on,
# 1.8 for a shell, 4.3 with every allowlisted key; above it only *-extra
# grants (a warning) or a regression (an error) can go.
MAX_EXPOSURE=4.5
THRESHOLD=45        # --threshold counts tenths

check() {
  "$DSBD" --check --config "$CONF" ${DEV:+--dev} || return 1
  [ -z "$DEV" ] || return 0     # user units: most sandboxing is not scored
  if ! systemd-analyze security --help 2>/dev/null | grep -q -- --offline; then
    echo "warning: systemd-analyze has no --offline; units not scored"; return 0
  fi
  t="$(mktemp -d)"
  "$DSBD" --generate "$t" --config "$CONF" >/dev/null
  bad=0
  for u in "$t"/dsb-*@.service; do
    [ -e "$u" ] || continue
    if ! out="$(systemd-analyze security --offline=yes --threshold="$THRESHOLD" \
                --no-pager "$u" 2>&1)"; then
      n="${u##*/dsb-}"; n="${n%@.service}"
      score="$(printf '%s\n' "$out" | sed -n 's/.*: \([0-9.]*\) [A-Z].*/\1/p' | tail -1)"
      if grep -q '^# has \*-extra grants' "$u"; then
        echo "warning: [identity $n]: systemd-analyze exposure ${score:-?} is above $MAX_EXPOSURE, from its *-extra grants"
      else
        echo "error: [identity $n]: systemd-analyze exposure ${score:-?} is above $MAX_EXPOSURE with standard keys only: a dsb or systemd regression"
        bad=1
      fi
    fi
  done
  rm -rf "$t"
  return "$bad"
}

running() { $SC list-units --plain --no-legend --all 'dsb-*.socket' | awk '{print $1}'; }

stop_removed() {
  keep=" $(printf '%s ' $("$DSBD" --identities --config "$CONF")) "
  for u in $(running); do
    n="${u#dsb-}"; n="${n%.socket}"
    # the unit file is already gone, so its RemoveOnStop= is too: remove
    # the socket file here, or a stale one stays and says "cannot reach"
    case "$keep" in *" $n "*) ;; *) $SC stop "$u"; rm -f "$RUNDIR/$n.sock"; echo "stopped: $n" ;; esac
  done
}

case "$1" in
  check)
    if [ "${2:-}" = --show-deny ]; then exec "$DSBD" --show-deny --config "$CONF"; fi
    check && echo "$CONF: ok" ;;
  list)
    for n in $("$DSBD" --identities --config "$CONF"); do
      printf '%-16s %s\n' "$n" "$($SC is-active "dsb-$n.socket" || true)"
    done ;;
  apply)
    check || { echo "nothing changed" >&2; exit 1; }
    if [ -n "$DEV" ]; then
      mkdir -p "$D/bin" "$UNITS"
      # the sandbox has a private /tmp and a read-only $HOME: copy both in
      install -m 755 "$DSBD" "$D/bin/dsbd"
      rm -rf "$D/etc"; mkdir -p "$D/etc"
      cp "$CONF" "$D/etc/dsb.conf"
      [ ! -d "$(dirname "$CONF")/conf.d" ] || cp -r "$(dirname "$CONF")/conf.d" "$D/etc/"
      CONF="$D/etc/dsb.conf"
      rm -f "$UNITS"/dsb-*.socket "$UNITS"/dsb-*@.service "$UNITS"/sockets.target.wants/dsb-*
      "$DSBD" --generate "$UNITS" --config "$CONF" --dev --rundir "$D" --dsbd "$D/bin/dsbd"
      $SC daemon-reload
    else
      [ "$(id -u)" = 0 ] || { echo "dsb-admin apply: run as root" >&2; exit 1; }
      [ "$CONF" = /etc/dsb/dsb.conf ] || { echo "the generator reads /etc/dsb/dsb.conf only" >&2; exit 1; }
      users="$("$DSBD" --sysusers --config "$CONF")"
      [ -z "$users" ] || printf '%s\n' "$users" | systemd-sysusers -
      $SC daemon-reload                            # reruns dsb-generator
    fi
    stop_removed
    for n in $("$DSBD" --identities --config "$CONF"); do
      $SC restart "dsb-$n.socket"; echo "enabled: $n"
    done
    [ -z "$DEV" ] || echo "export DSB_RUNDIR=$D" ;;
  stop)
    [ -n "$DEV" ] || usage
    for u in $(running); do $SC stop "$u"; done
    rm -f "$UNITS"/dsb-*.socket "$UNITS"/dsb-*@.service "$UNITS"/sockets.target.wants/dsb-*
    $SC daemon-reload
    rm -rf "$D" ;;
  env)
    [ -n "$DEV" ] || usage
    echo "export DSB_RUNDIR=$D" ;;
  *) usage ;;
esac
